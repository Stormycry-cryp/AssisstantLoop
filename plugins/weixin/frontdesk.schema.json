{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reply": { "type": "string" },
    "quiet": { "type": "boolean" },
    "imageSummary": { "type": "string", "maxLength": 3000 },
    "useRecentImages": { "type": "boolean" },
    "remember": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 80 } },
    "sleepNudge": { "type": ["string", "null"], "maxLength": 30 },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["answer", "stop", "start", "followup"] },
          "card": { "type": ["integer", "null"] },
          "choice": { "type": ["integer", "null"] },
          "run": { "type": ["integer", "null"] },
          "agent": { "type": ["string", "null"], "enum": ["codex", "pi", "desktop", null] },
          "subject": { "type": ["string", "null"] },
          "title": { "type": ["string", "null"] }
        },
        "required": ["kind", "card", "choice", "run", "agent", "subject", "title"]
      }
    }
  },
  "required": ["reply", "actions"]
}
